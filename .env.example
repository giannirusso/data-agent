# Gemini (Google AI Studio). The prototype is tested with a free-tier key.
# Model ids are configurable. gemini-2.5-* is no longer available to new users.
# GEMINI_MODEL_PRO is the tier used for SQL and analysis. It defaults to Flash
# so a question stays well under 30s. Set a Pro id here if you want that tradeoff.
GOOGLE_API_KEY=
GEMINI_MODEL_PRO=gemini-3.8-flash
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20

# BigQuery billing project. Public dataset bigquery-public-data.thelook_ecommerce
# is queried with this project. Authenticate with:
#   gcloud auth application-default login
GCP_PROJECT=
BQ_DATASET=bigquery-public-data.thelook_ecommerce
BQ_MAX_BYTES=1000000000

# Salt for FARM_FINGERPRINT customer keys. Use a long random value in production.
PII_SALT=change-me-to-a-long-random-string

# Optional LangFuse. When these are empty, JSON logs are the only telemetry.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# heuristic (default, saves free-tier quota) or always
LLM_ROUTE=heuristic
# off, suspicious (default), or always
LLM_GUARD=suspicious
